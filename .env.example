# URL of the DocPulse API (see ../backend). Defaults to http://localhost:4000/api/v1
VITE_API_URL=http://localhost:4000/api/v1

# ---- Frontend-only demo (no backend needed; see ../DEMO.md) ----
# Everything below ends up in the public JavaScript bundle. Never put a server secret here.
# VITE_DEMO_MODE=true
# Password for the demo accounts (patient@ / doctor@ / admin@docpulse.demo). Default: Demo@1234
# VITE_DEMO_PASSWORD=
# LiveKit Cloud → project Settings → "Development token server" ID (enables real video calls)
# VITE_LIVEKIT_TOKEN_SERVER_ID=
# Optional: give your demo its own video rooms
# VITE_DEMO_ROOM_PREFIX=docpulse-demo

# Optional: store links for the "Download the app" section (shown as "Coming soon" until set)
# VITE_ANDROID_APP_URL=
# VITE_IOS_APP_URL=
